{{#form/auth-base title="Change Your Password" errorMessage=this.errorMessage}}
  {{#if this.isRegistered}}
    {{#elem/panel-form
      name="success"
      heading="Success"}}
      Your password has been changed.
    {{/elem/panel-form}}
  {{else}}
    <form {{action 'submitForm' on='submit'}}>
      {{auth-input
        type='password'
        value=this.oldPassword
        autocomplete="current-password"
        placeholder='Old Password'}}
      <Form::PasswordInput
        @requireGood={{true}}
        @autocomplete='new-password'
        @placeholder='New Password'
        @passwordChanged={{action (mut this.newPassword)}}
        />

      {{suggest-link
        suggest-text="Can't remember your password?"
        link-name="reset-request"
        link-pretty="Reset"}}
      {{elem/button-submit loading=(or this.isProcessing (not this.newPassword))}}
    </form>
  {{/if}}
{{/form/auth-base}}