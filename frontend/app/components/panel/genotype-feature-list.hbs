{{!--
  @param @featureFiltersCountOfDatasetInBrushedDomain
  @param @featureFiltersCount
  Both params are from manage-genotype
--}}
{{log 'GenotypeFeatureList args' @featureFiltersCountOfDatasetInBrushedDomain.length 'featureFiltersCountOfDatasetInBrushedDomain' @featureFiltersCount}}
{{!-- based on extracts from genotype-samples.hbs and manage-genotype.hbs --}}
<span class="GenotypeFeatureList sample-count">
  Sort by
  {{#if @userSettings.sortByPassportFields}}
    Passport fields
  {{else}}
    {{@featureFiltersCountOfDatasetInBrushedDomain.length}} SNPs
    {{#unless (eq @featureFiltersCountOfDatasetInBrushedDomain.length @featureFiltersCount) }} 
      in scope, out of {{@featureFiltersCount}}
    {{/unless}}
    {{!-- copied from manage-genotype.hbs : .snpsInBrushedDomain, with minor changes. --}}
    {{#each @featureFiltersCountOfDatasetInBrushedDomain as |feature|}}
      <div>{{feature.value_0}} &nbsp; : &nbsp; {{feature.matchRefNumeric}}</div>
    {{/each}}
  {{/if}}
</span>
