{{auth-input
  type=this.passwordInputType
  value=this.password
  autocomplete=@autocomplete
  placeholder=@placeholder}}

<div>
  <span style="margin-left: 3em;">
    {{input type="checkbox" checked=this.revealPassword
      id="checkbox-revealPassword" }}
    <label for="checkbox-revealPassword" title="Show Password">
      <i class="glyphicon glyphicon-eye-open"></i></label>
    {{#ember-tooltip side="right" delay=500}}
      Show password input
    {{/ember-tooltip}}
  </span>
</div>

{{!-- The route templates which use password-input use bootstrap form-group for layout.
Adding class="form-group" here provides the margin-bottom matching other inputs in the forms.
It seems .form-group is removed in Bootstrap 5; mb-3 is suggested by Gemini as a replacement here for form-group for spacing.
related : https://getbootstrap.com/docs/5.3/forms/input-group/
 --}}
{{#if this.passwordStrength}}
  <div class="form-group" style="margin-left: 3em;">
    <label>Password strength :</label>
    <span >
      <span>{{this.passwordStrengthText}}</span>
      {{#ember-tooltip side="right" delay=500}}
        A measure of the complexity of the input password.
      {{/ember-tooltip}}
      <Elem::ValueMeter @value={{this.guesses_log10}} @max=25 />
    </span>
  </div>
{{/if}}

