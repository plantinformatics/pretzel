{
  "initial:before": {
    "loopback#favicon": {}
  },
  "initial": {
    "./middleware/route_time": {},
    "./middleware/failed-request-throttle": {
      "params": {
        "windowMs": 900000,
        "slowDown": {
          "delayAfter": 5,
          "delayMs": 1000,
          "maxDelayMs": 10000
        },
        "rateLimit": {
          "max": 60
        }
      }
    },
    "compression": {},
    "cors": {
      "params": {
        "origin": true,
        "credentials": true,
        "maxAge": 86400
      }
    },
    "helmet#xssFilter": {},
    "helmet#frameguard": {
      "params": [
        "deny"
      ]
    },
    "helmet#hsts": {
      "params": {
        "maxAge": 0,
        "includeSubDomains": true
      }
    },
    "helmet#hidePoweredBy": {},
    "helmet#ieNoOpen": {},
    "helmet#noSniff": {},

    "./middleware/memcache": {
      "params": {
        "duration": 3600
      },
      "paths": ["/api/Blocks/pathsViaStream"]
    }
  },
  "session": {},
  "auth": {},
  "parse": {},
  "routes": {
    "loopback#rest": {
      "paths": [
        "${restApiRoot}"
      ]
    }
  },
  "files": {
  },
  "final:after": {
    "strong-error-handler": {}
  }
}
