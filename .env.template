# Example Docker Compose configuration. Replace all values marked CHANGE_ME.
# Do not commit real credentials or organisation-specific paths.

#---------------------------------------
# Define DB_USER and DB_PASS if MongoDB is configured with user/password
# DB_USER=CHANGE_ME
# DB_PASS=CHANGE_ME_use_a_long_random_password
#---------------------------------------

# These must be absolute paths on the Docker host. Docker must be able to
# create/write them. mntData is also used as the path inside the containers.
# A simple configuration is to group these directories within the parent
# pretzelDir created before cloning the repository. They can instead be
# unrelated absolute paths. On Windows, use a path such as C:/pretzelDir.
# Docker Desktop for MS Windows will translate the path separator (forward or
# back-slash) as required; to help it to recognise paths, use a device prefix
# such as C: and use absolute paths.
pretzelDir=/CHANGE_ME/absolute/path/to/pretzelDir
DATA_DIR=$pretzelDir/mongodb
mntData=$pretzelDir/data
blastDir=$pretzelDir/data/blast
landingPage=$pretzelDir/landing-page

# This dir maps to /Cache and contains 1 file : resultsCache
# (until ~v3.11.0 this was /app/node_modules/flat-cache/.cache)
resultsCacheDir=$pretzelDir/cache

DB_NAME=pretzel
# Set this to the public hostname when deploying behind a proxy.
API_HOST=localhost
# Leave empty for direct local access. Set to the proxy's external port when used.
API_PORT_PROXY=
API_PORT_EXT=3010
hostIp=blastserver
# Flask port is now internal to the compose network, so use fixed (default) 4000; 
# no need to configure via FLASK_PORT / BLASTSERVER_PORT.
BLASTSERVER_PORT=4000
# The value of API_PORT_PROXY is not (currently) a port, it is just defined or undefined.
MONGO_DEFAULT_PORT=27017
# For administrator verification of user email sign-ups, change to EMAIL_VERIFY to ADMIN,
# and define values for EMAIL_*
EMAIL_VERIFY=NONE
EMAIL_ADMIN=CHANGE_ME_admin@example.org
EMAIL_HOST=CHANGE_ME_smtp.example.org
EMAIL_PORT=587
EMAIL_PASS=CHANGE_ME_smtp_password
EMAIL_USER=CHANGE_ME_smtp_user
EMAIL_FROM=CHANGE_ME_pretzel@example.org
use_value_0=1
# Pretzel uses Hands-On-Table (https://handsontable.com) to display table data.
# If your organisation qualifies for non-commercial-and-evaluation use, uncomment this
#handsOnTableLicenseKey=non-commercial-and-evaluation
